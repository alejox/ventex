# Copiar a .env.local y completar. NUNCA commitear .env.local.

# --- Supabase (obligatorio) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: bypassea RLS. Solo server-side (utils/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Base pública del sitio. La usan los correos de auth y, sobre todo, las URLs de
# notificación y retorno que se le pasan a dLocal: tiene que ser alcanzable
# DESDE INTERNET o el webhook nunca llega (en local el pago se resuelve igual,
# porque el polling relee el pago en dLocal).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Correo (Resend) ---
# Invitaciones de empleados y el enlace de acceso del checkout de invitado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- dLocal Go (cobro de suscripciones) ---
# "production" usa api.dlocalgo.com con DLOCAL_API_KEY/DLOCAL_SECRET_KEY.
# Cualquier otro valor (o vacío) usa el sandbox api-sbx.dlocalgo.com con las
# DLOCAL_SBX_*. El default es sandbox a propósito: un deploy sin configurar no
# puede cobrarle plata real a nadie.
DLOCAL_ENV=sandbox

# Producción
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=

# Sandbox
DLOCAL_SBX_API_KEY=
DLOCAL_SBX_SECRET_KEY=

# Cron de renovaciones (/api/billing/recurring). OBLIGATORIO para que la ruta
# funcione: sin este valor devuelve 503 en vez de quedar abierta. Vercel inyecta
# el header `Authorization: Bearer $CRON_SECRET` automáticamente cuando la
# variable existe en el proyecto.
CRON_SECRET=

# --- Opcionales ---
# Base del cliente axios (services/http.ts) para APIs externas.
NEXT_PUBLIC_API_URL=
