# Copiar a .env.local y completar. NUNCA commitear .env.local.

# --- Supabase (obligatorio) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: bypassea RLS. Solo server-side (utils/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Base pública del sitio. La usan los correos de auth y, sobre todo, las URLs de
# confirmación y retorno que se le pasan a ePayco: tiene que ser alcanzable DESDE
# INTERNET o la confirmación nunca llega. OJO en el deploy: si esta variable
# queda con `localhost`, publicUrlBase() la reescribe a 127.0.0.1 y ePayco no
# puede alcanzarla NI DESDE PRODUCCIÓN. En local el pago se resuelve igual,
# porque el polling relee la transacción en ePayco por nuestra referencia.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Correo (Resend) ---
# Invitaciones de empleados y el enlace de acceso del checkout de invitado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- ePayco (cobro de suscripciones) ---
# Son CUATRO secretos, de DOS bloques distintos del panel de ePayco. Faltando
# uno solo, EPAYCO_CONFIGURED queda en false y /api/billing/subscribe responde
# 503 sin cobrar nada.

# Autentican el API (POST /login, Basic PUBLIC:PRIVATE).
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=

# Firman la confirmación (webhook). NO son las mismas de arriba.
# Verificación cruzada: el `sub` del JWT que devuelve /login tiene que ser IGUAL
# a P_CUST_ID_CLIENTE. Si no lo es, las llaves son de cuentas distintas y la
# firma del webhook no va a validar NUNCA — toda confirmación se responde 401.
EPAYCO_P_CUST_ID_CLIENTE=
EPAYCO_P_KEY=

# "production" cobra plata real. Cualquier otro valor (o vacío) es modo prueba.
# El default es prueba a propósito: un deploy sin configurar no puede cobrarle a
# nadie. Ojo: ePayco NO tiene host de sandbox aparte — el modo lo definen las
# llaves más este flag, que viaja al checkout del navegador.
EPAYCO_MODE=test

# Cron de renovaciones (/api/billing/recurring). OBLIGATORIO para que la ruta
# funcione: sin este valor devuelve 503 en vez de quedar abierta. Vercel inyecta
# el header `Authorization: Bearer $CRON_SECRET` automáticamente cuando la
# variable existe en el proyecto.
CRON_SECRET=

# --- Opcionales ---
# Base del cliente axios (services/http.ts) para APIs externas.
NEXT_PUBLIC_API_URL=
